# Do not commit the real public.env file. Generate the password hash with:
# docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext 'long password'
DEMO_PUBLIC_HOST=36-103-234-95.sslip.io
DEMO_PUBLIC_ORIGIN=https://36-103-234-95.sslip.io
DEMO_BASIC_AUTH_USER=demo
# Keep the real bcrypt hash single-quoted so Compose treats its dollar signs literally.
DEMO_BASIC_AUTH_HASH='replace-with-caddy-bcrypt-hash'

DEMO_AIRFOIL_LIBRARY_ROOT=/demo-assets/uiuc
SURROGATE_NEWTON_MODEL_DIR=/models
SURROGATE_NEWTON_RUNTIME_DIR=/runtime
DEMO_MAX_PENDING_JOBS=64
DEMO_MAX_PENDING_JOBS_PER_CLIENT=4
DEMO_NK_BURST_LIMIT=3
DEMO_COLD_START_MAX_WAIT_SEC=300
DEMO_JOB_RESULT_TTL_SEC=86400
DEMO_CASE_TTL_SEC=86400
DEMO_JOB_CLEANUP_INTERVAL_SEC=60
DEMO_CANCEL_GRACE_SEC=30
DEMO_HARD_TIMEOUT_EXIT=1
DEMO_MESH_JOB_TIMEOUT_SEC=600
DEMO_PREDICT_JOB_TIMEOUT_SEC=600
DEMO_RECOVER_JOB_TIMEOUT_SEC=7200
DEMO_REFERENCE_JOB_TIMEOUT_SEC=7200
