# Reproducible Surrogate-Newton ADflow configuration (GNU Fortran + MPICH).
PMAKE = make -j @JOBS@

FF90 = @ENV_PREFIX@/bin/mpifort
CC   = @ENV_PREFIX@/bin/mpicc

FF90_INTEGER_PRECISION_FLAG =
FF90_REAL_PRECISION_FLAG =
CC_INTEGER_PRECISION_FLAG =
CC_REAL_PRECISION_FLAG =

CGNS_INCLUDE_FLAGS = -I@CGNS_PREFIX@/include
CGNS_LINKER_FLAGS = -L@CGNS_PREFIX@/lib -Wl,-rpath,@CGNS_PREFIX@/lib -lcgns
COMPLEXIFY_INCLUDE_FLAGS =
COMPLEXIFY_LINKER_FLAGS =

FF77_FLAGS = -fPIC -fdefault-real-8 -fdefault-double-8
FF90_FLAGS = $(FF77_FLAGS) -std=f2008
FFXX_OPT_FLAGS = -O3 -ffast-math
C_FLAGS = -fPIC -O2

AR = @ENV_PREFIX@/bin/x86_64-conda-linux-gnu-ar
AR_FLAGS = -rvs
LINKER = $(FF90)
LINKER_FLAGS = -Wl,-rpath,@ENV_PREFIX@/lib

include @ENV_PREFIX@/lib/petsc/conf/variables
PETSC_INCLUDE_FLAGS = ${PETSC_CC_INCLUDES} -I@ENV_PREFIX@
PETSC_LINKER_FLAGS = ${PETSC_LIB}

FF90_PRECISION_FLAGS = $(FF90_INTEGER_PRECISION_FLAG)$(FF90_REAL_PRECISION_FLAG)
CC_PRECISION_FLAGS = $(CC_INTEGER_PRECISION_FLAG) $(CC_REAL_PRECISION_FLAG)

PYTHON = @ENV_PREFIX@/bin/python
PYTHON-CONFIG = @ENV_PREFIX@/bin/python3-config
F2PY = @ENV_PREFIX@/bin/f2py
